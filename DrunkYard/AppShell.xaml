<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DrunkYard.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DrunkYard"
    xmlns:views="clr-namespace:DrunkYard.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="DrunkYard">

    <TabBar>

        <ShellContent
            Title="Játékok"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:GamesPage}"
            Route="GamesPage" />

        <ShellContent
            Title="Szavazás"
            Icon="dotnet_bot.png"
            ContentTemplate="{DataTemplate views:VotePage}"
            Route="VotePage" />

        <ShellContent
            Title="Új Játék"
            Icon="dotnet_bot.png" 
            ContentTemplate="{DataTemplate views:AddGamePage}"
            Route="AddGamePage" />

    </TabBar>

</Shell>